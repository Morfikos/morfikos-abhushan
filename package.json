{
  "name": "aabhushan",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --parallel --filter @aabhushan/web --filter @aabhushan/api --filter @aabhushan/worker dev",
    "generate:client": "pnpm --filter @aabhushan/contracts generate:client",
    "verify:org-context": "pnpm --filter @aabhushan/db verify:org-context",
    "verify:inventory": "pnpm --filter @aabhushan/db verify:inventory",
    "verify:barcodes": "pnpm --filter @aabhushan/db verify:barcodes",
    "verify:customers": "pnpm --filter @aabhushan/db verify:customers",
    "verify:invoice-calculation": "pnpm --filter @aabhushan/db verify:invoice-fixtures && pnpm --filter @aabhushan/db verify:invoice-calculation",
    "verify:pos-billing": "pnpm --filter @aabhushan/db verify:pos-billing",
    "verify:payments": "pnpm --filter @aabhushan/db verify:payments",
    "verify:returns": "pnpm --filter @aabhushan/db verify:returns",
    "verify:girvi": "pnpm --filter @aabhushan/db verify:girvi",
    "verify:girvi-settlement": "pnpm --filter @aabhushan/db verify:girvi-fixtures && pnpm --filter @aabhushan/db verify:girvi-settlement",
    "verify:documents": "pnpm --filter @aabhushan/db verify:documents",
    "verify:notifications": "pnpm --filter @aabhushan/db verify:notifications",
    "verify:reports": "pnpm --filter @aabhushan/db verify:reports",
    "seed:calculation-policy": "pnpm --filter @aabhushan/db seed:calculation-policy",
    "seed:girvi-calculation-policy": "pnpm --filter @aabhushan/db seed:girvi-calculation-policy",
    "repair:girvi-policy-snapshots": "pnpm --filter @aabhushan/db repair:girvi-policy-snapshots",
    "seed:sample-articles": "pnpm --filter @aabhushan/db seed:sample-articles",
    "seed:sample-customers": "pnpm --filter @aabhushan/db seed:sample-customers",
    "seed:sample-unpaid-invoices": "pnpm --filter @aabhushan/db seed:sample-unpaid-invoices"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.3.1",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "unrs-resolver"],
    "overrides": {
      "thread-stream": "3.1.0"
    }
  }
}
