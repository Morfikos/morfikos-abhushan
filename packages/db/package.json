{
  "name": "@aabhushan/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "verify:org-context": "tsx --env-file=../../.env ./scripts/verify-org-context.ts",
    "verify:inventory": "tsx --env-file=../../.env ./scripts/verify-inventory.ts",
    "verify:barcodes": "tsx --env-file=../../.env ./scripts/verify-barcodes.ts",
    "verify:customers": "tsx --env-file=../../.env ./scripts/verify-customers.ts",
    "verify:invoice-calculation": "tsx --env-file=../../.env ./scripts/verify-invoice-calculation.ts",
    "verify:invoice-fixtures": "tsx ./scripts/verify-invoice-fixtures.ts",
    "verify:pos-billing": "tsx --env-file=../../.env ./scripts/verify-pos-billing.ts",
    "verify:payments": "tsx --env-file=../../.env ./scripts/verify-payments.ts",
    "verify:returns": "tsx --env-file=../../.env ./scripts/verify-returns.ts",
    "seed:calculation-policy": "tsx --env-file=../../.env ./scripts/seed-calculation-policy.ts",
    "seed:sample-articles": "tsx --env-file=../../.env ./scripts/seed-sample-articles.ts",
    "seed:sample-customers": "tsx --env-file=../../.env ./scripts/seed-sample-customers.ts",
    "seed:sample-unpaid-invoices": "tsx --env-file=../../.env ./scripts/seed-sample-unpaid-invoices.ts"
  },
  "dependencies": {
    "@aabhushan/application": "workspace:*",
    "@aabhushan/contracts": "workspace:*",
    "@aabhushan/domain": "workspace:*",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
