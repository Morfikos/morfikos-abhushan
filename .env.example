# Copy to .env for local API, worker, and Compose.
# Do not commit real secrets, backups, or customer exports.

NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aabhushan_dev
CORS_ORIGINS=http://localhost:3000
API_HOST=0.0.0.0
API_PORT=3001
LOG_LEVEL=info
# Use LOG_LEVEL=debug to print CORS preflight, health, and successful GET /api/v1/me polls.

# Supabase Auth. ECC projects verify access tokens from JWKS (ES256), not a shared HS256 secret.
# Never put JWT secrets, sb_secret_ keys, or the service role in NEXT_PUBLIC_*.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
# Optional overrides; defaults are ${SUPABASE_URL}/auth/v1 and its .well-known/jwks.json
# SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
# SUPABASE_JWT_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# Privileged secret (sb_secret_ / service role) is required to send staff invitations
# and to upload/sign the private shop-assets logo bucket (see docs/shop-logo-storage.md).
# SUPABASE_SECRET_KEY=sb_secret_replace-me
# Optional web origin used in invitation redirect links; defaults to the first CORS origin.
# WEB_ORIGIN=http://localhost:3000

# Spec 14 — official WhatsApp Cloud API (optional until provider is ready).
# Without these, notification sends fail honestly with WHATSAPP_NOT_CONFIGURED (never fake delivery).
# See docs/whatsapp-provider-setup.md.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_TEMPLATE_INVOICE=transactional_invoice
# WHATSAPP_TEMPLATE_RECEIPT=transactional_receipt
# WHATSAPP_TEMPLATE_DUE_REMINDER=due_reminder
# WHATSAPP_TEMPLATE_GIRVI_REMINDER=girvi_reminder

NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=Aabhushan
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_replace-me
